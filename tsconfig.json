{
	"compilerOptions": {
		"baseUrl": "./",
		"declaration": true,
		"esModuleInterop": true,
		"lib": [
			"es6"
		],
		"module": "commonjs",
		"noImplicitAny": false,
		"outDir": "Target",
		"rootDir": "src",
		"strict": true,
		"target": "es6"
	},
	"exclude": [
		"__test__",
		"lib",
		"node_modules"
	],
	"extends": "@playform/build/tsconfig",
	"include": [
		"src",
		"src",
		"src"
	]
}
